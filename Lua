    t.Success = t.Success or rgb(52, 211, 120)
    t.Warning = t.Warning or rgb(245, 176, 65)
    t.Danger = t.Danger or rgb(240, 82, 82)
    t.AccentText = t.AccentText or rgb(255, 255, 255)
    return t
end

