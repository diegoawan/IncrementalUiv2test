    function Window:SetVisible(v)
        v = v == true
        if v == Window.Visible then return end
        Window.Visible = v
        visToken += 1
        local tok = visToken
        closeDropdown()
        if v then
            hideLauncher()
            root.Visible = true
            uiScale.Scale = scale * 0.94
            tween(uiScale, { Scale = scale }, 0.45)
            tween(main, { GroupTransparency = 0 }, 0.25)
            tween(shadow, { ImageTransparency = 0.5 }, 0.3)
            playSweep()
        else
            tween(uiScale, { Scale = scale * 0.94 }, 0.25)
            tween(main, { GroupTransparency = 1 }, 0.2)
            tween(shadow, { ImageTransparency = 1 }, 0.2)
            task.delay(0.26, function() if visToken == tok then root.Visible = false end end)
            showLauncher()
        end
    end
