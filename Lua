local function resolveTheme(name)
    if type(name) == "table" then
        local t = table.clone(UI.Themes.GreyWhite)
        for k, v in pairs(name) do if typeof(v) == "Color3" then t[k] = v end end
        return t
    end
    local n = UI.ThemeAliases[name] or name
    return table.clone(UI.Themes[n] or UI.Themes.GreyWhite)
end

--==== UTILITIES ====--
local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    o.Parent = parent
    return o
end

local function corner(o, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o)
end

local function tween(o, props, dur, style, dir)
    local t = TweenService:Create(o, TweenInfo.new(dur or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function playerGui()
    return Player:WaitForChild("PlayerGui")
end

local function initialOf(name)
    return string.upper(string.sub(name or "I", 1, 1))
end

local function loadAvatar(imageLabel)
    task.spawn(function()
        local ok, img = pcall(function()
            return Players:GetUserThumbnailAsync(Player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
        end)
        if ok and img and imageLabel.Parent then imageLabel.Image = img end
    end)
end

local SHADOW_IMAGE = "rbxassetid://6014261993"
local function makeShadow(parent, grow, transparency)
    return new("ImageLabel", {
        Name = "Shadow", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.new(1, grow, 1, grow), BackgroundTransparency = 1, Image = SHADOW_IMAGE,
        ImageColor3 = Color3.new(0, 0, 0), ImageTransparency = transparency or 0.5,
        ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450), ZIndex = 0,
    }, parent)
end

local function spawnBat(parent, opts)
    opts = opts or {}
    local size = opts.Size or math.random(24, 34)
    local z = opts.ZIndex or 1
    local holder = new("Frame", {
        Name = "Bat", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(size, size),
        Position = UDim2.fromScale(math.random(), math.random()), BackgroundTransparency = 1, ZIndex = z,
    }, parent)
    local glyph = new("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "🦇", TextSize = size,
        Font = Enum.Font.GothamBold, TextColor3 = Color3.new(1, 1, 1),
        TextTransparency = opts.Transparency or (0.35 + math.random() * 0.25), ZIndex = z,
    }, holder)
    local flap = new("UIScale", { Scale = 1 }, glyph)

    task.spawn(function() -- wing beat
        local rate = 0.10 + math.random() * 0.06
        while holder.Parent do
            tween(flap, { Scale = 0.72 }, rate, Enum.EasingStyle.Sine)
            task.wait(rate)
            tween(flap, { Scale = 1.1 }, rate, Enum.EasingStyle.Sine)
            task.wait(rate)
        end
    end)
    task.spawn(function() -- body wobble
        while holder.Parent do
            tween(glyph, { Rotation = math.random(-12, 12) }, 0.25, Enum.EasingStyle.Sine)
            task.wait(0.25)
        end
    end)
    task.spawn(function() -- flight path
        task.wait(math.random() * 1.2)
        local px = holder.Position.X.Scale
        while holder.Parent do
            local tx, ty = -0.05 + math.random() * 1.1, 0.05 + math.random() * 0.9
            local dur = 2.2 + math.random() * 3
            tween(holder, { Rotation = math.clamp((tx - px) * 50, -20, 20) }, 0.5, Enum.EasingStyle.Sine)
            tween(holder, { Position = UDim2.fromScale(tx, ty) }, dur, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(dur)
            px = tx
            if math.random() < 0.3 then
                tween(holder, { Rotation = 0 }, 0.3)
                task.wait(0.3 + math.random() * 0.8)
            end
        end
    end)
    return holder
end

--==== KEY SYSTEM ====--
function UI:CreateKeySystem(options)
    options = options or {}
    local theme = resolveTheme(options.Theme or "GreyWhite")

    local keys = options.Key
    if keys == nil then keys = { "Test" } end
    if type(keys) == "string" then keys = { keys } end
    local function isValid(input)
        for _, k in ipairs(keys) do if input == k then return true end end
        return false
    end

    local gui = new("ScreenGui", {
        Name = "IncrementalUi_KeySystem", ResetOnSpawn = false, IgnoreGuiInset = true,
        DisplayOrder = 1000, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, playerGui())

    local dim = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0 }, gui)
    tween(dim, { BackgroundTransparency = 0.45 }, 0.4)

    local blur
    pcall(function()
        blur = Instance.new("BlurEffect")
        blur.Size = 0
        blur.Parent = Lighting
        tween(blur, { Size = 14 }, 0.4)
    end)

    local root = new("Frame", {
        Size = UDim2.fromOffset(360, 292), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1,
    }, dim)
    local rootScale = new("UIScale", { Scale = 0.94 }, root)
    local shadow = makeShadow(root, 56, 1)

    local card = new("CanvasGroup", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = theme.Background, BorderSizePixel = 0, GroupTransparency = 1,
    }, root)
    corner(card, 12)
    new("UIStroke", { Color = theme.Border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, card)

    for _ = 1, 5 do spawnBat(card) end

    tween(card, { GroupTransparency = 0 }, 0.3)
    tween(shadow, { ImageTransparency = 0.45 }, 0.4)
    tween(rootScale, { Scale = 1 }, 0.45)

    -- thin accent line along the top edge
    local topLine = new("Frame", { Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = theme.Accent, BorderSizePixel = 0 }, card)
    new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }, topLine)

    -- header
    local logo = new("Frame", { Size = UDim2.fromOffset(38, 38), Position = UDim2.fromOffset(24, 24), BackgroundColor3 = theme.Accent, BorderSizePixel = 0 }, card)
    corner(logo, 10)
    new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), rgb(190, 190, 200)), Rotation = 45 }, logo)
    new("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = initialOf(options.Title or "Incremental"),
        TextColor3 = theme.AccentText, Font = Enum.Font.GothamBold, TextSize = 18,
    }, logo)

    new("TextLabel", {
        Position = UDim2.fromOffset(74, 24), Size = UDim2.new(1, -98, 0, 20), BackgroundTransparency = 1,
        Text = options.Title or "Authentication", TextColor3 = theme.Text, Font = Enum.Font.GothamBold,
        TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left,
    }, card)
    new("TextLabel", {
        Position = UDim2.fromOffset(74, 44), Size = UDim2.new(1, -98, 0, 18), BackgroundTransparency = 1,
        Text = options.Subtitle or "Enter your key to continue", TextColor3 = theme.Muted, Font = Enum.Font.Gotham,
        TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
    }, card)

    new("Frame", { Position = UDim2.fromOffset(24, 80), Size = UDim2.new(1, -48, 0, 1), BackgroundColor3 = theme.Border, BorderSizePixel = 0 }, card)

    -- profile chip
    local chip = new("Frame", { Position = UDim2.fromOffset(24, 96), Size = UDim2.new(1, -48, 0, 50), BackgroundColor3 = theme.Element, BackgroundTransparency = 0.1, BorderSizePixel = 0 }, card)
    corner(chip, 8)
    local avatar = new("ImageLabel", {
        Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(34, 34), BackgroundColor3 = theme.ElementHover,
        BorderSizePixel = 0, ScaleType = Enum.ScaleType.Crop,
    }, chip)
    corner(avatar, 999)
    loadAvatar(avatar)
    new("TextLabel", {
        Position = UDim2.fromOffset(52, 9), Size = UDim2.new(1, -62, 0, 16), BackgroundTransparency = 1, Text = Player.DisplayName,
        TextColor3 = theme.Text, Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
    }, chip)
    new("TextLabel", {
        Position = UDim2.fromOffset(52, 26), Size = UDim2.new(1, -62, 0, 14), BackgroundTransparency = 1, Text = "@" .. Player.Name,
        TextColor3 = theme.Muted, Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
    }, chip)

    -- input
    local box = new("TextBox", {
        Position = UDim2.fromOffset(24, 160), Size = UDim2.new(1, -48, 0, 40), BackgroundColor3 = theme.Element,
        Text = "", PlaceholderText = "Enter your key", PlaceholderColor3 = theme.Muted, TextColor3 = theme.Text,
        Font = Enum.Font.GothamMedium, TextSize = 13, ClearTextOnFocus = false, BorderSizePixel = 0,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, card)
    corner(box, 8)
    new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, box)
    local boxStroke = new("UIStroke", { Color = theme.Border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, box)
    box.Focused:Connect(function() tween(boxStroke, { Color = theme.Accent }, 0.2) end)
    box.FocusLost:Connect(function() tween(boxStroke, { Color = theme.Border }, 0.2) end)

    local status = new("TextLabel", {
        Position = UDim2.fromOffset(24, 204), Size = UDim2.new(1, -48, 0, 16), BackgroundTransparency = 1, Text = "",
        TextColor3 = theme.Danger, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1,
    }, card)
    local function setStatus(text, color)
        status.Text = text
        status.TextColor3 = color
        status.TextTransparency = 1
        tween(status, { TextTransparency = 0 }, 0.2)
    end

    -- buttons
    local function button(text, x, w, bg, fg)
        local b = new("TextButton", {
            Position = UDim2.new(x, x == 0 and 24 or 4, 0, 230), Size = UDim2.new(w, w == 0.38 and -28 or -28, 0, 40),
            BackgroundColor3 = bg, Text = text, TextColor3 = fg, Font = Enum.Font.GothamMedium,
            TextSize = 13, BorderSizePixel = 0, AutoButtonColor = false,
        }, card)
        corner(b, 8)
        return b
    end
    local getBtn = new("TextButton", {
        Position = UDim2.fromOffset(24, 230), Size = UDim2.new(0.38, -18, 0, 40), BackgroundColor3 = theme.Element,
        Text = "Get Key", TextColor3 = theme.Text, Font = Enum.Font.GothamMedium, TextSize = 13, BorderSizePixel = 0, AutoButtonColor = false,
    }, card)
    corner(getBtn, 8)
    new("UIStroke", { Color = theme.Border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, getBtn)
    local verifyBtn = new("TextButton", {
        Position = UDim2.new(0.38, 6, 0, 230), Size = UDim2.new(0.62, -30, 0, 40), BackgroundColor3 = theme.Accent,
        Text = "Verify", TextColor3 = theme.AccentText, Font = Enum.Font.GothamBold, TextSize = 13, BorderSizePixel = 0, AutoButtonColor = false,
    }, card)
    corner(verifyBtn, 8)
    local _ = button -- (kept for readability; buttons above are built explicitly)

    getBtn.MouseEnter:Connect(function() tween(getBtn, { BackgroundColor3 = theme.ElementHover }, 0.15) end)
    getBtn.MouseLeave:Connect(function() tween(getBtn, { BackgroundColor3 = theme.Element }, 0.15) end)
    verifyBtn.MouseEnter:Connect(function() tween(verifyBtn, { BackgroundTransparency = 0.12 }, 0.15) end)
    verifyBtn.MouseLeave:Connect(function() tween(verifyBtn, { BackgroundTransparency = 0 }, 0.15) end)

    getBtn.Activated:Connect(function()
        local link = options.GetKeyLink or "https://example.com/get-key"
        local ok = pcall(function() setclipboard(link) end)
        if ok then
            setStatus("Link copied to clipboard.", theme.Success)
        else
            setStatus(link, theme.Muted)
        end
    end)

    local busy = false
    local function attempt()
        if busy then return end
        local input = string.match(box.Text, "^%s*(.-)%s*$")
        if isValid(input) then
            busy = true
            verifyBtn.Text = "Verified"
            tween(verifyBtn, { BackgroundColor3 = theme.Success }, 0.25)
            tween(boxStroke, { Color = theme.Success }, 0.25)
            setStatus("Key accepted.", theme.Success)
            task.wait(0.7)
            tween(card, { GroupTransparency = 1 }, 0.3)
            tween(shadow, { ImageTransparency = 1 }, 0.3)
            tween(rootScale, { Scale = 0.94 }, 0.3)
            tween(dim, { BackgroundTransparency = 1 }, 0.35)
            if blur then tween(blur, { Size = 0 }, 0.35) end
            task.wait(0.4)
            if blur then blur:Destroy() end
            gui:Destroy()
            if options.OnSuccess then task.spawn(options.OnSuccess) end
        else
            setStatus(input == "" and "Please enter a key." or "Invalid key. Please try again.", theme.Danger)
            tween(boxStroke, { Color = theme.Danger }, 0.15)
            task.spawn(function()
                local origin = root.Position
                for i = 1, 6 do
                    local dir = (i % 2 == 0) and 1 or -1
                    tween(root, { Position = origin + UDim2.fromOffset(dir * (10 - i), 0) }, 0.04)
                    task.wait(0.04)
                end
                tween(root, { Position = origin }, 0.1)
            end)
            task.delay(2, function()
                if busy or not gui.Parent then return end
                tween(status, { TextTransparency = 1 }, 0.4)
                tween(boxStroke, { Color = box:IsFocused() and theme.Accent or theme.Border }, 0.4)
            end)
        end
    end
    verifyBtn.Activated:Connect(attempt)
    box.FocusLost:Connect(function(enter) if enter then attempt() end end)

    return gui
end

--==== MAIN WINDOW ====--
function UI:CreateWindow(options)
    options = options or {}
    local theme = resolveTheme(options.Theme or "GreyWhite")
    local themeName = type(options.Theme) == "string" and options.Theme or "Custom"
    local windowName = options.Name or "IncrementalUi"

    -- sizing
    local mobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
    local cam = workspace.CurrentCamera
    local viewport = cam and cam.ViewportSize or Vector2.new(1280, 720)
    local baseW, baseH = 660, 440
    local baseSize = options.Size or UDim2.fromOffset(baseW, baseH)
    local fullW = baseSize.X.Offset > 0 and baseSize.X.Offset or baseW
    local fullH = baseSize.Y.Offset > 0 and baseSize.Y.Offset or baseH
    local scale = math.min((viewport.X - (mobile and 30 or 40)) / fullW, (viewport.Y - (mobile and 90 or 40)) / fullH, mobile and 0.85 or 1)
    scale = math.clamp(scale, 0.55, 1)

    local HEADER_H, SIDEBAR_W = 44, 164

    local gui = new("ScreenGui", {
        Name = "IncrementalUi_" .. string.sub(HttpService:GenerateGUID(false), 1, 6),
        ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 100, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, playerGui())

    ---------------------------------------------------------------- theming
    local bindings, hooks, conns = {}, {}, {}

    local function make(class, props, parent, themed)
        local o = new(class, props, nil)
        if themed then
            for prop, key in pairs(themed) do
                o[prop] = theme[key]
                table.insert(bindings, { o, prop, key })
            end
        end
        o.Parent = parent
        return o
    end
    local function onTheme(fn) table.insert(hooks, fn) end
    local function connect(signal, fn)
        local c = signal:Connect(fn)
        table.insert(conns, c)
        return c
    end
    local function strokeT(parent, key, thickness, transparency)
        return make("UIStroke", {
            Thickness = thickness or 1, Transparency = transparency or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, parent, { Color = key or "Border" })
    end
    local function label(parent, text, key, props)
        local p = {
            BackgroundTransparency = 1, Text = text, Font = Enum.Font.GothamMedium, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromScale(1, 1),
        }
        for k, v in pairs(props or {}) do p[k] = v end
        return make("TextLabel", p, parent, { TextColor3 = key or "Text" })
    end

    local function refreshTheme()
        for i = #bindings, 1, -1 do
            local b = bindings[i]
            if b[1]:IsDescendantOf(gui) then
                tween(b[1], { [b[2]] = theme[b[3]] }, 0.3)
            else
                table.remove(bindings, i)
            end
        end
        for _, fn in ipairs(hooks) do fn() end
    end

    ---------------------------------------------------------------- frame
    local root = new("Frame", {
        Name = "Root", Size = baseSize, AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1,
    }, gui)
    local uiScale = new("UIScale", { Scale = scale * 0.94 }, root)
    local shadow = makeShadow(root, 60, 1)

    local main = make("CanvasGroup", {
        Name = "Main", Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, GroupTransparency = 1,
    }, root, { BackgroundColor3 = "Background" })
    corner(main, 12)
    strokeT(main, "Border", 1, 0)

    -- background layer: drifting light band + flying bats (sits under all content)
    local batLayer = new("Frame", { Name = "Background", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 1 }, main)
    local glow = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 1 }, batLayer)
    local glowGrad = new("UIGradient", {
        Rotation = 30, Offset = Vector2.new(-1, 0),
        Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.955), NumberSequenceKeypoint.new(1, 1) }),
    }, glow)
    task.spawn(function()
        while glow.Parent do
            glowGrad.Offset = Vector2.new(-1, 0)
            tween(glowGrad, { Offset = Vector2.new(1, 0) }, 9, Enum.EasingStyle.Linear)
            task.wait(9.5)
        end
    end)

    local function playSweep()
        local sw = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0.3, 0, 1.8, 0), Position = UDim2.fromScale(-0.3, 0.5),
            Rotation = 18, BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 30,
        }, main)
        new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.9), NumberSequenceKeypoint.new(1, 1) }) }, sw)
        tween(sw, { Position = UDim2.fromScale(1.3, 0.5) }, 0.9, Enum.EasingStyle.Quad)
        task.delay(1, function() sw:Destroy() end)
    end

    local Window = {
        ScreenGui = gui, Root = root, Main = main, Tabs = {}, ActiveTab = nil, Config = {}, NamedConfigs = {},
        Controls = {}, Theme = theme, ThemeName = themeName, Visible = true, Destroyed = false,
        Keybind = options.Keybind or Enum.KeyCode.RightControl, _dd = nil,
    }
    table.insert(UI.Windows, Window)

    local bats = {}
    function Window:SpawnBat()
        local b = spawnBat(batLayer)
        table.insert(bats, b)
        return b
    end
    function Window:ClearBats()
        for _, b in ipairs(bats) do b:Destroy() end
        table.clear(bats)
    end
    function Window:SetBats(n)
        Window:ClearBats()
        for _ = 1, n or 0 do Window:SpawnBat() end
    end
